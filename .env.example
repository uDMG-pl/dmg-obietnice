# Cloudflare Turnstile (widget type: Invisible)
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# MongoDB (obietnice, zgloszenia, rate_limits)
MONGODB_URI=
MONGODB_DB=
MONGODB_COLLECTION=obietnice

# Better Auth / API keys
# Wygeneruj co najmniej 32 losowe znaki, np. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
API_KEY_OWNER_EMAIL=api-keys@dmg-obietnice.invalid
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000

# Limit zgłoszeń na IP (domyślnie: 5 na 15 min)
ZGLOS_RATE_LIMIT_MAX=5
ZGLOS_RATE_LIMIT_WINDOW_SEC=900
